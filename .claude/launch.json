{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "postgres",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up"],
      "port": 5432
    },
    {
      "name": "auth-server",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "."],
      "port": 8080
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && go run ."],
      "port": 9090
    }
  ]
}
